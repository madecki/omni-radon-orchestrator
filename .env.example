# =============================================================================
# OmniRadon workspace — reference environment
# =============================================================================
# Optional: copy the **LAN dev** line(s) below into a real `.env` at this repo root
# (same folder as `run.mjs`). `node run.mjs dev` loads that file so you do not
# need `export` in bash/PowerShell. Git ignores `.env`.
#
# Copy real `.env` files from each service’s `.env.example` under its own folder.
# Below are **example values** you can reuse locally so tokens stay in sync.
#
# ── Local-only shared secrets (≥32 chars; replace in any real deployment) ───
#
#   Gateway `DIARY_SERVICE_TOKEN`  = Diary API `GATEWAY_SERVICE_TOKEN`
#   Gateway `SETTINGS_SERVICE_TOKEN` = Settings API `GATEWAY_SERVICE_TOKEN`
#   Gateway `TASKS_SERVICE_TOKEN`  = Task Manager API `GATEWAY_SERVICE_TOKEN`
#   Gateway `SETTINGS_SERVICE_TOKEN` = Task Manager API `SETTINGS_SERVICE_TOKEN`
#
OMNIRADON_EXAMPLE_SERVICE_TOKEN=local-dev-omniradon-service-token-min-32-chars-required

# Same string as above, for auth-service (encryption + internal API; use openssl in prod):
OMNIRADON_EXAMPLE_AUTH_SECRET=local-dev-omniradon-auth-encryption-min-32-chars-x

# ── LAN / custom hostname dev (optional): workspace-root `.env` (see README) ─
# Host only (no scheme). Next.js configs derive asset URLs and allowedDevOrigins
# from this; gateway document origin is assumed http://<host>:3000.
# NEXT_PUBLIC_DEV_HOST=192.168.1.5

# ── Typical local URLs (also set in gateway/.env and app .env files) ──────────
EXAMPLE_GATEWAY_URL=http://localhost:3000
EXAMPLE_AUTH_API_URL=http://localhost:4001
EXAMPLE_DIARY_API_URL=http://localhost:4281
EXAMPLE_SETTINGS_API_URL=http://localhost:4381
EXAMPLE_TASKS_API_URL=http://localhost:4481

# Paths to per-service examples:
#   gateway/.env.example
#   auth-service/.env.example
#   diary/apps/diary-api/.env.example
#   diary/apps/diary-web/.env.example
#   diary/apps/diary-worker/.env.example
#   settings/apps/settings-api/.env.example
#   task-manager/apps/task-manager-api/.env.example
#   llm-service/.env.example
